{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mentor",
  "model": "opencode/big-pickle",

  // Format files after the agent edits them, using available built-in
  // formatters. A formatter only runs when its executable or project
  // dependency is present.
  "formatter": true,

  "experimental": {
    // Subagents cannot start their own subagents.
    "subagent_depth": 1,
    // Give agents a todo tool for multi-step work and plan tracking.
    "todo": true
  },

  "watcher": {
    "ignore": ["node_modules/**", "dist/**", "coverage/**", ".git/**"]
  },

  // Ordered rules. The last matching rule wins, so broad defaults come
  // first and specific exceptions later. The posture is: allow routine
  // work without prompts, ask before effectful operations, and rely on
  // the mandatory change review (AGENTS.md section 7) as the control for
  // edits.
  "permissions": [
    // Anything outside the active project asks first.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // The agent's own configuration and learning ledger are a deliberate
    // exception, so reading the ledger does not prompt on every session.
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    // Scratch space under /tmp skips the outside-project prompt; the
    // secret-file and effectful-command rules still apply there.
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },

    // Reads are allowed, except for secret-bearing files.
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "ask" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "**/*.pem", "effect": "ask" },
    { "action": "read", "resource": "**/*.key", "effect": "ask" },
    { "action": "read", "resource": "**/.aws/**", "effect": "ask" },
    { "action": "read", "resource": "**/.config/gcloud/**", "effect": "ask" },
    { "action": "read", "resource": "**/.config/gh/**", "effect": "ask" },
    { "action": "read", "resource": "**/.docker/config.json", "effect": "ask" },
    { "action": "read", "resource": "**/.kube/config", "effect": "ask" },
    { "action": "read", "resource": "**/.npmrc", "effect": "ask" },
    { "action": "read", "resource": "**/.pypirc", "effect": "ask" },
    { "action": "read", "resource": "**/.git-credentials", "effect": "ask" },

    // Shell commands run without prompting, so read-only inspection such
    // as `git status` or `gh issue list` is frictionless. Effectful
    // commands below still ask; the last matching rule wins.
    { "action": "shell", "resource": "*", "effect": "allow" },

    // Filesystem mutations.
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "chmod -R *", "effect": "ask" },
    { "action": "shell", "resource": "chown -R *", "effect": "ask" },
    { "action": "shell", "resource": "chgrp -R *", "effect": "ask" },

    // Remote and history-changing Git operations. Local commits and
    // inspection stay allowed.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout * -- *", "effect": "ask" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },
    { "action": "shell", "resource": "git mv *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git tag -d *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop*", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear*", "effect": "ask" },

    // GitHub CLI mutations. Read-only gh commands such as `gh issue list`,
    // `gh pr view`, or `gh run list` stay allowed.
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr close *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr reopen *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr ready *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr review *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue create *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue close *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue reopen *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue transfer *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue pin *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue unpin *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo create *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo archive *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo rename *", "effect": "ask" },
    { "action": "shell", "resource": "gh release create *", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh release edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh release upload *", "effect": "ask" },
    { "action": "shell", "resource": "gh gist create *", "effect": "ask" },
    { "action": "shell", "resource": "gh gist delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh gist edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh label create *", "effect": "ask" },
    { "action": "shell", "resource": "gh label delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh label edit *", "effect": "ask" },
    { "action": "shell", "resource": "gh secret set *", "effect": "ask" },
    { "action": "shell", "resource": "gh secret delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh variable set *", "effect": "ask" },
    { "action": "shell", "resource": "gh variable delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh workflow run *", "effect": "ask" },
    { "action": "shell", "resource": "gh workflow enable *", "effect": "ask" },
    { "action": "shell", "resource": "gh workflow disable *", "effect": "ask" },
    { "action": "shell", "resource": "gh run rerun *", "effect": "ask" },
    { "action": "shell", "resource": "gh run cancel *", "effect": "ask" },
    // `gh api` can send any HTTP method, so it cannot be classified as
    // read-only by prefix, and `gh auth token` prints the stored token.
    { "action": "shell", "resource": "gh api *", "effect": "ask" },
    { "action": "shell", "resource": "gh auth token*", "effect": "ask" },
    { "action": "shell", "resource": "gh auth login *", "effect": "ask" },
    { "action": "shell", "resource": "gh auth logout *", "effect": "ask" },
    { "action": "shell", "resource": "gh auth switch *", "effect": "ask" },

    // Docker mutations that destroy container or volume state.
    { "action": "shell", "resource": "docker rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker rmi *", "effect": "ask" },
    { "action": "shell", "resource": "docker kill *", "effect": "ask" },
    { "action": "shell", "resource": "docker container prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker image prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker network rm *", "effect": "ask" },
    { "action": "shell", "resource": "docker network prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "docker compose down *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose kill *", "effect": "ask" },
    { "action": "shell", "resource": "docker compose rm *", "effect": "ask" },

    // Publish and remote-execution commands.
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "cargo publish *", "effect": "ask" },
    { "action": "shell", "resource": "twine upload *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "ask" },
    { "action": "shell", "resource": "rsync *", "effect": "ask" },

    // Process and system control.
    { "action": "shell", "resource": "kill *", "effect": "ask" },
    { "action": "shell", "resource": "pkill *", "effect": "ask" },
    { "action": "shell", "resource": "killall *", "effect": "ask" },
    { "action": "shell", "resource": "systemctl *", "effect": "ask" },
    { "action": "shell", "resource": "mount *", "effect": "ask" },
    { "action": "shell", "resource": "umount *", "effect": "ask" },

    // Package managers.
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "dnf *", "effect": "ask" },
    { "action": "shell", "resource": "yum *", "effect": "ask" },
    { "action": "shell", "resource": "pacman *", "effect": "ask" },
    { "action": "shell", "resource": "brew *", "effect": "ask" },

    // Nested or dynamically built shell commands bypass prefix matching,
    // so they ask.
    { "action": "shell", "resource": "bash -c*", "effect": "ask" },
    { "action": "shell", "resource": "bash -lc*", "effect": "ask" },
    { "action": "shell", "resource": "sh -c*", "effect": "ask" },
    { "action": "shell", "resource": "sh -lc*", "effect": "ask" },
    { "action": "shell", "resource": "zsh -c*", "effect": "ask" },
    { "action": "shell", "resource": "zsh -lc*", "effect": "ask" },
    { "action": "shell", "resource": "eval *", "effect": "ask" },
    { "action": "shell", "resource": "xargs *", "effect": "ask" },

    // Edits run without prompting; the mandatory change review in
    // AGENTS.md section 7 is the control. Secret-bearing files still
    // ask, mirroring the read rules above.
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "**/.ssh/**", "effect": "ask" },
    { "action": "edit", "resource": "**/id_rsa*", "effect": "ask" },
    { "action": "edit", "resource": "**/*.pem", "effect": "ask" },
    { "action": "edit", "resource": "**/*.key", "effect": "ask" },
    { "action": "edit", "resource": "**/.aws/**", "effect": "ask" },
    { "action": "edit", "resource": "**/.config/gcloud/**", "effect": "ask" },
    { "action": "edit", "resource": "**/.config/gh/**", "effect": "ask" },
    { "action": "edit", "resource": "**/.docker/config.json", "effect": "ask" },
    { "action": "edit", "resource": "**/.kube/config", "effect": "ask" },
    { "action": "edit", "resource": "**/.npmrc", "effect": "ask" },
    { "action": "edit", "resource": "**/.pypirc", "effect": "ask" },
    { "action": "edit", "resource": "**/.git-credentials", "effect": "ask" },

    // Subagents run without prompting; each one's own permission rules
    // still constrain it, and `mentor` keeps its read-only allowlist.
    { "action": "subagent", "resource": "*", "effect": "allow" },

    // These are safe and local to the configured skills and web tools.
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" }
  ],

  // Policies are hard denials. They run after permission rules and saved
  // approvals, so an agent cannot override them with a broad shell allow.
  "policies": [
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:mkfs*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:shutdown*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:reboot*", "effect": "deny" }
  ]
}
