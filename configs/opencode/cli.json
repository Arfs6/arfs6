{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "leader": "ctrl+x",
    "command.palette.show": "ctrl+p"
  },
  "session": {
    "permissions": "prompt"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
